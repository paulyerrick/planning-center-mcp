{
  "name": "planning-center-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Planning Center Online — lets Claude work directly with your church's PCO data",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:connection": "tsx src/test-connection.ts"
  },
  "keywords": [
    "mcp",
    "planning-center",
    "church",
    "model-context-protocol",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
